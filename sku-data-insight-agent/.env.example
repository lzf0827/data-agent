# Copy to .env. Never commit a real key.
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.5-flash
AGNES_TIMEOUT_SECONDS=90
AGNES_PROXY_URL=http://apac.zscaler.proxy.pgn.philips.com:10015
AGNES_RESPONSE_FORMAT=json_schema
# Production: set required=true and allow_fallback=false to fail closed.
AGNES_REQUIRED=false
AGNES_ALLOW_FALLBACK=true
AGNES_INTENT_LLM_FIRST=false
# Open document lane (SQLite is the local fallback; use a managed DB/object store adapter for multi-instance production).
PROTO_L3_ENABLED=true
MEMORY_STORE_PATH=.work/memory
ARTIFACT_MAX_MB=100
LOCAL_TOOLS_ENABLED=false
LOCAL_TOOL_MAX_CALLS=8
OFFICIAL_SEARCH_CACHE_SECONDS=21600
